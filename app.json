      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Connection",
            "fr": "Connexion",
            "nl": "Verbinding"
          },
          "children": [
            {
              "id": "host",
              "type": "text",
              "label": {
                "en": "IP address",
                "fr": "Adresse IP",
                "nl": "IP-adres"
              },
              "hint": {
                "en": "Reserve a fixed address for the UPS — or for the NAS that relays it — in your router. A moving address is the usual reason a UPS stops answering.",
                "fr": "Réservez une adresse fixe pour l’onduleur — ou pour le NAS qui le relaie — dans votre routeur. Une adresse qui bouge est la raison habituelle d’un onduleur qui cesse de répondre.",
                "nl": "Reserveer een vast adres voor de UPS — of voor de NAS die hem doorgeeft — in je router. Een wisselend adres is de gebruikelijke reden dat een UPS niet meer antwoordt."
              },
              "value": ""
            },
            {
              "id": "community",
              "type": "password",
              "label": {
                "en": "SNMP community",
                "fr": "Communauté SNMP",
                "nl": "SNMP-community"
              },
              "hint": {
                "en": "Almost always \"public\". It is a weak shared secret, so it is masked here — but it stays editable, because getting it wrong is the most common reason a UPS answers nothing at all.",
                "fr": "Presque toujours « public ». C’est un secret partagé faible : il est donc masqué ici, mais il reste modifiable, car s’être trompé est la première cause d’un onduleur qui ne répond rien.",
                "nl": "Vrijwel altijd \"public\". Het is een zwak gedeeld geheim en wordt daarom gemaskeerd — maar blijft bewerkbaar, want een verkeerde waarde is de meest voorkomende reden dat een UPS niets antwoordt."
              },
              "value": "public"
            },
            {
              "id": "version",
              "type": "dropdown",
              "label": {
                "en": "SNMP version",
                "fr": "Version SNMP",
                "nl": "SNMP-versie"
              },
              "hint": {
                "en": "v2c reports missing values one by one; v1 fails the whole read when a single value is absent. Only fall back to v1 if v2c gets no answer.",
                "fr": "v2c signale les valeurs absentes une par une ; v1 fait échouer tout le relevé dès qu’une seule valeur manque. Ne passez à v1 que si v2c ne répond pas.",
                "nl": "v2c meldt ontbrekende waarden afzonderlijk; v1 laat de hele uitlezing mislukken zodra één waarde ontbreekt. Val alleen terug op v1 als v2c niet antwoordt."
              },
              "value": "v2c",
              "values": [
                {
                  "id": "v2c",
                  "label": {
                    "en": "v2c",
                    "fr": "v2c",
                    "nl": "v2c"
                  }
                },
                {
                  "id": "v1",
                  "label": {
                    "en": "v1",
                    "fr": "v1",
                    "nl": "v1"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Monitoring",
            "fr": "Surveillance",
            "nl": "Bewaking"
          },
          "children": [
            {
              "id": "live_interval",
              "type": "number",
              "label": {
                "en": "Read power state every (seconds)",
                "fr": "Relever l’état secteur toutes les (secondes)",
                "nl": "Lees de voedingsstatus elke (seconden)"
              },
              "hint": {
                "en": "Battery state, runtime and load. This is what makes a power cut reach a Flow in seconds — raising it above a minute mostly defeats the point of the app.",
                "fr": "État batterie, autonomie et charge. C’est ce qui fait qu’une coupure atteint un Flow en quelques secondes — monter au-delà d’une minute retire l’essentiel de l’intérêt de l’app.",
                "nl": "Accustatus, looptijd en belasting. Dit zorgt ervoor dat een stroomuitval binnen seconden een Flow bereikt — hoger dan een minuut haalt grotendeels het nut van de app weg."
              },
              "value": 10,
              "min": 5,
              "max": 3600,
              "units": {
                "en": "s"
              }
            },
